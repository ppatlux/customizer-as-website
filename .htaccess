# Clickjacking protection: stop this app from being loaded inside an <iframe>
# on another site. Without this, an attacker could frame the page (invisibly
# or disguised) and trick a click into landing on the consent "Continue"
# button or a download/print action instead of whatever the attacker shows on
# top ("clickjacking"). X-Frame-Options is the older/more compatible header;
# frame-ancestors is its modern CSP replacement - both are set for coverage
# across browsers. 'self' still allows framing pages of this app by each
# other (e.g. engrave.html inside index.html, if that's ever done) and by any
# other page on this same origin.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Force browsers/in-app webviews to always revalidate the HTML entry points and
# local JS/CSS with the server instead of serving a stale copy from disk cache.
# Without this, some mobile browsers and app-embedded webviews cache these
# aggressively and never notice a new deploy (the ?v= query param on
# app.js/app.css bumps on deploy to force a fresh fetch even on clients that
# ignore Cache-Control revalidation).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Compress model files on the fly. This is lossless (the browser gets back the
# exact same bytes), and the binary models shrink to roughly a third, which
# matters most on phones. .3mf and .zip are already zip archives, and the app
# checks STL sizes before using them, so those are left alone too.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/step .step .stp
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE model/gltf-binary model/step application/json image/svg+xml text/html text/css text/javascript application/javascript
</IfModule>
